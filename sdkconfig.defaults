#
# Serial flasher config
#
CONFIG_ESPTOOLPY_FLASHMODE_DIO=y
CONFIG_ESPTOOLPY_FLASHFREQ_80M=y
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y

#
# Serial console (keep in sync with monitor_speed in platformio.ini)
#
# "Custom" keeps UART0 on GPIO1/3 but unlocks the baud rate setting.
CONFIG_ESP_CONSOLE_UART_CUSTOM=y
CONFIG_ESP_CONSOLE_UART_BAUDRATE=921600

#
# Partition Table
#
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions_16MB.csv"

#
# Chip (ESP32-D0WDQ6-V3)
#
CONFIG_ESP32_REV_MIN_3=y
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y

#
# PSRAM (8 MB)
#
CONFIG_SPIRAM=y
CONFIG_SPIRAM_SPEED_80M=y
CONFIG_SPIRAM_USE_MALLOC=y
# Route heap allocations >= 4 KB to PSRAM by default, freeing internal DRAM.
CONFIG_SPIRAM_MALLOC_ALWAYSINTERNAL=4096
CONFIG_SPIRAM_MALLOC_RESERVE_INTERNAL=32768
CONFIG_SPIRAM_TRY_ALLOCATE_WIFI_LWIP=y
CONFIG_SPIRAM_ALLOW_BSS_SEG_EXTERNAL_MEMORY=y
CONFIG_SPIRAM_ALLOW_NOINIT_SEG_EXTERNAL_MEMORY=y
CONFIG_FREERTOS_TASK_CREATE_ALLOW_EXT_MEM=y

#
# Bluetooth (BLE only, used for Wi-Fi provisioning)
#
CONFIG_BT_ENABLED=y
CONFIG_BT_NIMBLE_ENABLED=y
CONFIG_BTDM_CTRL_MODE_BLE_ONLY=y

#
# Networking
#
CONFIG_LWIP_LOCAL_HOSTNAME="Core2ForAWS"
# BSP BLE provisioning uses protocomm security 1.
CONFIG_ESP_PROTOCOMM_SUPPORT_SECURITY_VERSION_1=y

#
# mbedTLS
#
CONFIG_MBEDTLS_EXTERNAL_MEM_ALLOC=y
# Release the large TLS handshake buffers once each handshake completes.
CONFIG_MBEDTLS_DYNAMIC_BUFFER=y
CONFIG_MBEDTLS_CERTIFICATE_BUNDLE=y
CONFIG_MBEDTLS_CERTIFICATE_BUNDLE_DEFAULT_CMN=y
CONFIG_MBEDTLS_X509_CRL_PARSE_C=y

#
# Core2 for AWS hardware features
#
CONFIG_SOFTWARE_BSP_SUPPORT=y
CONFIG_SOFTWARE_AUDIO_SUPPORT=y
CONFIG_SOFTWARE_CRYPTO_SUPPORT=y
CONFIG_SOFTWARE_DISPLAY_SUPPORT=y
CONFIG_SOFTWARE_BUTTON_SUPPORT=y
CONFIG_SOFTWARE_MOTION_SUPPORT=y
CONFIG_SOFTWARE_RTC_SUPPORT=y
CONFIG_SOFTWARE_RGB_LED_SUPPORT=y
CONFIG_SOFTWARE_SDCARD_SUPPORT=y
CONFIG_SOFTWARE_EXPANSION_PORTS_SUPPORT=y
CONFIG_SOFTWARE_WIFI_SUPPORT=y
CONFIG_CORE2FORAWS_LCD_DRAW_BUF_LINES=20

#
# Core dump (stored in the "coredump" partition)
#
CONFIG_ESP_COREDUMP_ENABLE_TO_FLASH=y

#
# LVGL
#
# The ILI9342C takes big-endian RGB565; the BSP renders in this format directly.
CONFIG_LV_COLOR_FORMAT_RGB565_SWAPPED=y
# Use the C-library allocator so LVGL's heap can spill to PSRAM instead of
# reserving a fixed 64 KB builtin pool in internal DRAM up-front. The
# DMA draw buffers stay in internal RAM (allocated separately by the port).
CONFIG_LV_USE_CLIB_MALLOC=y
CONFIG_LV_FONT_MONTSERRAT_12=y
CONFIG_LV_FONT_MONTSERRAT_14=y
CONFIG_LV_FONT_MONTSERRAT_16=y
CONFIG_LV_FONT_MONTSERRAT_18=y
CONFIG_LV_FONT_MONTSERRAT_20=y
CONFIG_LV_FONT_DEFAULT_MONTSERRAT_16=y

#
# esp-cryptoauthlib (ATECC608 Trust&GO)
#
CONFIG_ATECC608A_TNG=y
# CONFIG_MBEDTLS_ECP_RESTARTABLE is not set
CONFIG_ATCA_I2C_SDA_PIN=21
CONFIG_ATCA_I2C_SCL_PIN=22
CONFIG_ATCA_I2C_ADDRESS=0x6A
